// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Usuarios y Permisos
// ============================================================

model Rol {
  id_rol   Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(100)
  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id_usuario Int     @id @default(autoincrement())
  tipo_doc   String  @db.VarChar(50)
  num_doc    String  @db.VarChar(50)
  nombre     String  @db.VarChar(255)
  mail       String? @db.VarChar(255)
  password   String? @db.VarChar(255)
  id_rol     Int?

  rol                    Rol?      @relation(fields: [id_rol], references: [id_rol])
  reservas_como_profesor Reserva[] @relation("ProfesorReserva")
  menores_a_cargo        Menor[]   @relation("TutorMenores")

  @@unique([tipo_doc, num_doc], name: "uq_usuario_doc")
  @@map("usuario")
}

// ============================================================
// Menores a Cargo de Tutores
// ============================================================

model Menor {
  id_menor         Int           @id @default(autoincrement())
  id_tutor         Int
  nombre           String        @db.VarChar(255)
  apellido         String        @db.VarChar(255)
  tipo_doc         String        @db.VarChar(50)
  num_doc          String        @db.VarChar(50)
  fecha_nacimiento DateTime      @db.Date
  ficha_medica_url String?       @db.VarChar(500)
  cud_url          String?       @db.VarChar(500)

  tutor            Usuario       @relation("TutorMenores", fields: [id_tutor], references: [id_usuario])
  inscripciones    Inscripcion[]

  @@unique([tipo_doc, num_doc], name: "uq_menor_doc")
  @@map("menor")
}

// ============================================================
// Espacios Físicos
// ============================================================

model EspacioFisico {
  id_espacio  Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(255)
  descripcion String? @db.VarChar(255)

  reservas Reserva[]

  @@map("espacio_fisico")
}

// ============================================================
// Actividades
// ============================================================

model CategoriaActividad {
  id_categoria Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(255)
  actividades  Actividad[]

  @@map("categoria_actividad")
}

model Actividad {
  id_actividad          Int                 @id @default(autoincrement())
  nombre                String              @db.VarChar(255)
  descripcion           String?             @db.VarChar(255)
  id_categoria          Int?
  requiere_autorizacion Boolean             @default(false)

  categoria             CategoriaActividad? @relation(fields: [id_categoria], references: [id_categoria])
  reservas              Reserva[]

  @@map("actividad")
}

model EstadoReserva {
  id_estado_reserva Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(100)
  reservas          Reserva[]

  @@map("estado_reserva")
}

model Reserva {
  id_reserva        Int      @id @default(autoincrement())
  id_actividad      Int?
  id_espacio        Int?
  id_profesor       Int?
  fecha_hora_inicio DateTime
  fecha_hora_fin    DateTime
  cupo_maximo       Int?
  id_estado_reserva Int?

  actividad     Actividad?     @relation(fields: [id_actividad], references: [id_actividad])
  espacio       EspacioFisico? @relation(fields: [id_espacio], references: [id_espacio])
  profesor      Usuario?       @relation("ProfesorReserva", fields: [id_profesor], references: [id_usuario])
  estado        EstadoReserva? @relation(fields: [id_estado_reserva], references: [id_estado_reserva])
  reserva_items ReservaItem[]
  inscripciones Inscripcion[]

  @@map("reserva")
}

// ============================================================
// Inscripciones (Menores inscritos en Reservas)
// ============================================================

model EstadoInscripcion {
  id_estado_inscripcion Int           @id @default(autoincrement())
  nombre                String        @db.VarChar(100)
  inscripciones         Inscripcion[]

  @@map("estado_inscripcion")
}

model Inscripcion {
  id_inscripcion         Int                @id @default(autoincrement())
  id_reserva             Int
  id_menor               Int
  autorizacion_url       String?            @db.VarChar(500)
  fecha_hora_inscripcion DateTime           @default(now())
  id_estado_inscripcion  Int?

  reserva                Reserva            @relation(fields: [id_reserva], references: [id_reserva])
  menor                  Menor              @relation(fields: [id_menor], references: [id_menor])
  estado                 EstadoInscripcion? @relation(fields: [id_estado_inscripcion], references: [id_estado_inscripcion])

  @@unique([id_reserva, id_menor], name: "uq_inscripcion_reserva_menor")
  @@map("inscripcion")
}

// ============================================================
// Inventario
// ============================================================

model CategoriaInventario {
  id_categoria Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)
  items        Item[]

  @@map("categoria_inventario")
}

model Item {
  id_item      Int    @id @default(autoincrement())
  nombre       String @db.VarChar(255)
  cantidad     Int    @default(0)
  id_categoria Int?

  categoria     CategoriaInventario? @relation(fields: [id_categoria], references: [id_categoria])
  reserva_items ReservaItem[]

  @@map("item")
}

model ReservaItem {
  id_reserva Int
  id_item    Int
  cantidad   Int @default(1)

  reserva Reserva @relation(fields: [id_reserva], references: [id_reserva])
  item    Item    @relation(fields: [id_item], references: [id_item])

  @@id([id_reserva, id_item])
  @@map("reserva_item")
}
