# ==========================================
# Base de Datos (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=tupoli_root_secret
DB_NAME=tupoli_db
DB_USER=tupoli_user
DB_PASSWORD=tupoli_password

# ==========================================
# Backend API (NestJS)
# ==========================================
PORT=3000
NODE_ENV=development

# Prisma Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d
