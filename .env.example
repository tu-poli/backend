# ==========================================
# Base de Datos (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_ROOT_PASSWORD=tupoli_root_secret
DB_NAME=tupoli_db
DB_USER=tupoli_user
DB_PASSWORD=tupoli_password

# ==========================================
# Backend API (NestJS)
# ==========================================
PORT=3000
NODE_ENV=development

# IMPORTANTE: Los archivos .env NO soportan interpolación de variables.
# Escribí el valor completo y literal según tu entorno:
# Desarrollo local (con docker-compose-dev.yaml): HOST=localhost, PORT=3306 (o el que mapeaste)
# Producción (dentro de docker-compose-prod.yaml): HOST=mysql (nombre del servicio)
DATABASE_URL="mysql://tupoli_user:tupoli_password@localhost:3306/tupoli_db"

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d
