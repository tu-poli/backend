# ==========================================
# Base de Datos (MySQL)
# ==========================================

# Nombre del contenedor de Docker para la base de datos y puerto
DB_HOST=tupoli_db
DB_PORT=33306

# Nombre de base de datos principal
DB_NAME=tupoli_db

# Credenciales
DB_USER=tupoli_user
DB_PASSWORD=tupoli_password
DB_ROOT_PASSWORD=tupoli_root_secret

# ==========================================
# Backend API (NestJS)
# ==========================================
PORT=3000
NODE_ENV=development
# Ejecutar datos de prueba (seeds) al arrancar el contenedor: true / false
RUN_SEEDS=true

# IMPORTANTE: Prisma requiere DATABASE_URL en texto plano.
# Por defecto apunta al contenedor de la base de datos (tupoli_db).
DATABASE_URL="mysql://tupoli_user:tupoli_password@tupoli_db:3306/tupoli_db"

# Si corrés NestJS local fuera de Docker (npm run start:dev), usar esto.
#DATABASE_URL="mysql://tupoli_user:tupoli_password@localhost:33306/tupoli_db"

# JWT Secret
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d
