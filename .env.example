# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR (NestJS)
# ==============================================================================
PORT=3000
NODE_ENV=development
# Ejecutar datos de prueba (seeds) al arrancar: true / false
RUN_SEEDS=true

# ==============================================================================
# AUTENTICACIÓN (JWT)
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRES_IN=1d

# ==============================================================================
# BASE DE DATOS LOCAL CON DOCKER (PostgreSQL)
# ==============================================================================
DB_HOST=tupoli_db
DB_PORT=5432
DB_NAME=tupoli_db
DB_USER=tupoli_user
DB_PASSWORD=tupoli_password
DB_ROOT_PASSWORD=tupoli_root_secret

# ==============================================================================
# CONEXIÓN PRISMA (Elige una opción descomentando según tu entorno)
# ==============================================================================

# --- OPCIÓN 1: Desarrollo Local con Docker (Activa por defecto) ---
#DATABASE_URL="postgresql://tupoli_user:tupoli_password@localhost:5432/tupoli_db?schema=public"
#DIRECT_URL="postgresql://tupoli_user:tupoli_password@localhost:5432/tupoli_db?schema=public"

# --- OPCIÓN 2: Ejecución dentro de la red interna de Docker ---
DATABASE_URL="postgresql://tupoli_user:tupoli_password@tupoli_db:5432/tupoli_db?schema=public"
DIRECT_URL="postgresql://tupoli_user:tupoli_password@tupoli_db:5432/tupoli_db?schema=public"

# --- OPCIÓN 3: Supabase Cloud (Producción / Vercel o pruebas en la nube) ---
# DATABASE_URL="postgresql://postgres.<ID_PROYECTO>:<PASSWORD>@<HOST_POOLER>:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ID_PROYECTO>:<PASSWORD>@<HOST_POOLER>:5432/postgres"

# ==============================================================================
# ALMACENAMIENTO DE ARCHIVOS (Supabase Storage)
# ==============================================================================
SUPABASE_URL="https://<ID_PROYECTO>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET_DOCUMENTACION_MEDICA="documentacion_medica"
SUPABASE_BUCKET_AUTORIZACIONES="autorizaciones"
